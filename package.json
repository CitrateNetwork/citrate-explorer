{
  "name": "citrate-explorer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "CitrateScan \u2014 an AI-native BlockDAG explorer for the Citrate Network.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_RPC=1 vitest run",
    "typecheck": "tsc --noEmit",
    "indexer": "tsx scripts/indexer/run.ts",
    "indexer:once": "INDEXER_ONCE=1 tsx scripts/indexer/run.ts",
    "beacon": "tsx scripts/beacon/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "sync-addresses": "node scripts/sync-addresses.mjs",
    "sync-addresses:check": "node scripts/sync-addresses.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/react": "^3.0.195",
    "@neondatabase/serverless": "^1.1.0",
    "@privy-io/react-auth": "^3.28.0",
    "@privy-io/server-auth": "^1.32.5",
    "@privy-io/wagmi": "^4.0.10",
    "@tanstack/react-query": "^5.100.14",
    "ai": "^6.0.193",
    "d3-dag": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "solc": "^0.8.35",
    "viem": "^2.51.3",
    "wagmi": "^3.6.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "comment": "EX-B-005 (RM-Q, 2026-09-06): pin transitive deps out of their HIGH-severity advisory ranges. `next`/`eslint-config-next` are bumped directly above (>=16.2.11 for CVE-2026-64641/64642/64645/64649). These overrides clear the remaining runtime-reachable HIGHs that no direct bump fixes (solc still bundles tmp@0.0.33; next still ships sharp<0.35). Version selectors are scoped per-major where two majors are in the tree so we never force an incompatible major. Keep in lockstep with `pnpm audit --audit-level=high` (CI tripwire).",
    "overrides": {
      "tmp": ">=0.2.6",
      "sharp": ">=0.35.0",
      "axios@1": ">=1.18.0",
      "ws@8": ">=8.21.0",
      "brace-expansion": ">=1.1.18 <2.0.0 || >=5.0.9",
      "nanoid@3": ">=3.3.18",
      "js-yaml@4": ">=4.3.1",
      "postcss@8": ">=8.5.18",
      "browserslist@4": ">=4.28.7",
      "form-data@4": ">=4.0.6",
      "hono@4": ">=4.12.25",
      "socket.io-parser@4": ">=4.2.7",
      "minimatch@3>brace-expansion": ">=1.1.18 <2.0.0"
    }
  }
}
