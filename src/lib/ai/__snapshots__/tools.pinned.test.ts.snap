exports[`preserved tools: names and schemas > findTransfers keeps its input schema 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "address": {
      "description": "a counterparty to filter by",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "type": "string",
    },
    "amount": {
      "description": "human amount, e.g. '30k SALT' or '0.5 SALT'",
      "type": "string",
    },
    "comparator": {
      "default": "about",
      "enum": [
        "about",
        "atleast",
        "atmost",
        "exact",
      ],
      "type": "string",
    },
    "direction": {
      "default": "either",
      "enum": [
        "sent",
        "received",
        "either",
      ],
      "type": "string",
    },
    "limit": {
      "default": 10,
      "maximum": 100,
      "minimum": 1,
      "type": "integer",
    },
    "order": {
      "default": "biggest",
      "enum": [
        "biggest",
        "smallest",
        "recent",
      ],
      "type": "string",
    },
    "since": {
      "description": "time phrase, e.g. 'last week', 'last 24 hours', '2026-06-01'",
      "type": "string",
    },
    "token": {
      "description": "an ERC-20/721/1155 token address; omit for native SALT",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "type": "string",
    },
  },
  "required": [
    "comparator",
    "direction",
    "order",
    "limit",
  ],
  "type": "object",
}
`;

