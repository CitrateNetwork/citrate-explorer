# =============================================================================
# CitrateScan (citrate-explorer) environment.
# Copy to .env.local and fill in. The app + indexer BUILD and RUN with most of
# these unset (graceful degradation) — only the chain RPC vars are needed to
# read live data. See INSTALL.md.
# =============================================================================

# === Citrate chain (public, browser-safe) ===
NEXT_PUBLIC_CITRATE_CHAIN_ID=40204
NEXT_PUBLIC_CITRATE_RPC_URL=https://rpc.citrate.ai
NEXT_PUBLIC_CITRATE_WS_URL=wss://rpc.citrate.ai
# Direct node fallback used server-side ONLY (bypasses the edge if it blips):
CITRATE_RPC_FALLBACK=http://142.93.58.145:8545

# === Indexer worker (always-on Node process; NOT Vercel) ===
# Polling cadence when websocket newHeads is unavailable (ms):
INDEXER_POLL_MS=2000
# Block height to backfill from (0 = genesis; set to recent height for a fast start):
INDEXER_START_BLOCK=0
# Blocks of blue-score depth before a row is marked finalized (network finalityDepth=100):
INDEXER_FINALITY_DEPTH=100

# === Serverless database (Neon Postgres) ===
# Provisioned via Vercel Marketplace. Unset = no persistence/indexing (read-through to RPC).
DATABASE_URL=

# === Encryption / secrets (server-only) ===
# At-rest envelope key for third-party provider keys the agent uses server-side.
# Generate: openssl rand -base64 32
APP_MASTER_KEY=
# Pepper mixed into the salted hash of OUR issued API keys (keys are never recoverable).
# Generate: openssl rand -base64 32
API_KEY_PEPPER=

# === Privy auth (embedded wallets) ===
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# === AI agent inference (OpenAI-compatible; env-driven adapter) ===
# local | gateway | onchain
CITRATE_INFERENCE_MODE=gateway
CITRATE_GATEWAY_URL=https://infer.citrate.ai/v1
CITRATE_GATEWAY_API_KEY=
CITRATE_INFERENCE_URL=http://127.0.0.1:8080/v1
CITRATE_MODEL_NAME=gemma-4-E4B-it-Q4_K_M
# On-chain AI precompile targets (verified 2026-05-30):
NEXT_PUBLIC_MODEL_REGISTRY=0x077fbc3338a9e6bad90a3a041e6b7425689754ef
NEXT_PUBLIC_INFERENCE_ROUTER=0xad7c3135c1b9b3189208fd617b6b058c1c0469f3

# === Gasless writes (EIP-2771 CitrateForwarder relayer; server-only) ===
# Foundation relayer wallet — FUND with SALT before enabling sponsored writes:
RELAYER_PRIVATE_KEY=
# Set after the forwarder is deployed for this app:
NEXT_PUBLIC_FORWARDER_ADDRESS=

# === Contract verification (S-4) ===
# Vercel Sandbox token for the isolated solc compiler farm (set when S-4 lands):
VERCEL_SANDBOX_TOKEN=
