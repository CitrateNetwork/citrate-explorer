# =============================================================================
# CitrateScan (citrate-explorer) environment.
# Copy to .env.local and fill in. The app + indexer BUILD and RUN with most of
# these unset (graceful degradation) — only the chain RPC vars are needed to
# read live data. See INSTALL.md.
# =============================================================================

# === Site / SEO (public) ===
# Canonical origin for metadata, robots, sitemap, OG. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://explorer.citrate.ai
# Demo mode keeps the rich sample as a fallback while live data loads. Set to 0 in
# PRODUCTION so surfaces show ONLY live chain data (no sample fallback).
NEXT_PUBLIC_DEMO=1

# === Citrate chain (public, browser-safe) ===
NEXT_PUBLIC_CITRATE_CHAIN_ID=40204
NEXT_PUBLIC_CITRATE_RPC_URL=https://rpc.citrate.ai
NEXT_PUBLIC_CITRATE_WS_URL=wss://rpc.citrate.ai
# Optional direct-node fallback, server-side ONLY (bypasses the edge if it blips).
# OPT-IN — leave unset to use only the primary RPC. Prefer a TLS endpoint.
CITRATE_RPC_FALLBACK=

# === Indexer worker (always-on Node process; NOT Vercel) ===
# Polling cadence when websocket newHeads is unavailable (ms):
INDEXER_POLL_MS=2000
# Block height to backfill from (0 = genesis; set to recent height for a fast start):
INDEXER_START_BLOCK=0
# Blocks of blue-score depth before a row is marked finalized (network finalityDepth=100):
INDEXER_FINALITY_DEPTH=100

# === Serverless database (Neon Postgres) ===
# Provisioned via Vercel Marketplace. Unset = no persistence/indexing (read-through to RPC).
DATABASE_URL=

# === Encryption / secrets (server-only) ===
# At-rest envelope key for third-party provider keys the agent uses server-side.
# Generate: openssl rand -base64 32
APP_MASTER_KEY=
# Pepper mixed into the salted hash of OUR issued API keys (keys are never recoverable).
# Generate: openssl rand -base64 32
API_KEY_PEPPER=

# === Rate limiting (P-8) ===
# Cross-instance limiter store (Upstash Redis REST). When unset, the limiter falls
# back to a per-instance in-memory bucket (best-effort; fine for local/dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Auth seam — generic OIDC relying party (src/lib/auth) ===
# The explorer authenticates behind ONE seam. mode: mock | oidc | privy.
#   mock  — dev default; instant login as the dev wallet, no authority needed.
#   oidc  — Authorization Code + PKCE against the Citrate authority (citrate-identity).
#   privy — optional fallback to the existing Privy flow (adapter only).
#
# OIDC is now LIVE: citrate-explorer is a registered relying party of the Citrate
# identity authority. Flip NEXT_PUBLIC_AUTH_MODE to `oidc` and uncomment the oidc
# block below to authenticate against the authority instead of the mock issuer.
NEXT_PUBLIC_AUTH_MODE=oidc
# Dev identity for mock mode (NOT a real key — a dev wallet address only):
NEXT_PUBLIC_AUTH_MOCK_ADDRESS=0xf78c4b2091ad55e0a7c0e3b8f4a1d9c62b0d2915

# --- oidc mode (citrate-explorer is a registered RP of the Citrate authority) ---
# Local authority runs at http://localhost:3000; PROD: https://auth.citrate.ai.
# Public client (browser, Authorization Code + PKCE — no client secret):
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:3000
NEXT_PUBLIC_OIDC_AUTHORIZE_URL=http://localhost:3000/authorize
NEXT_PUBLIC_OIDC_TOKEN_URL=http://localhost:3000/token
NEXT_PUBLIC_OIDC_CLIENT_ID=citrate-explorer
NEXT_PUBLIC_OIDC_SCOPE=openid profile wallet
# Redirect URI the explorer sends is `${origin}/auth/callback` (path is hardcoded in
# src/lib/auth/config.ts). The authority MUST register this redirect_uri for the
# citrate-explorer client — it now does. Locally that is
# http://localhost:3001/auth/callback (explorer's dev port); PROD:
# https://explorer.citrate.ai/auth/callback.
# Server verification (JWKS — issuer + audience + signature checked by jose):
OIDC_ISSUER=http://localhost:3000
OIDC_JWKS_URL=http://localhost:3000/jwks
OIDC_AUDIENCE=citrate-explorer
# PROD server verification:
#   OIDC_ISSUER=https://auth.citrate.ai
#   OIDC_JWKS_URL=https://auth.citrate.ai/jwks
#   OIDC_AUDIENCE=citrate-explorer
# PROVISIONAL claim names — override only when the identity ADR ratifies them:
AUTH_CLAIM_SUB=sub
AUTH_CLAIM_WALLET=wallet_address

# --- privy mode (optional adapter only; do NOT use as the primary auth) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# === AI agent inference (OpenAI-compatible; env-driven adapter) ===
# local | gateway | onchain
CITRATE_INFERENCE_MODE=gateway
CITRATE_GATEWAY_URL=https://infer.citrate.ai/v1
CITRATE_GATEWAY_API_KEY=
CITRATE_INFERENCE_URL=http://127.0.0.1:8080/v1
CITRATE_MODEL_NAME=gemma-4-E4B-it-Q4_K_M
# On-chain AI precompile targets (verified 2026-05-30):
NEXT_PUBLIC_MODEL_REGISTRY=0x077fbc3338a9e6bad90a3a041e6b7425689754ef
NEXT_PUBLIC_INFERENCE_ROUTER=0xad7c3135c1b9b3189208fd617b6b058c1c0469f3

# === Gasless writes (EIP-2771 CitrateForwarder relayer; server-only) ===
# Foundation relayer wallet — FUND with SALT before enabling sponsored writes:
RELAYER_PRIVATE_KEY=
# Set after the forwarder is deployed for this app:
NEXT_PUBLIC_FORWARDER_ADDRESS=

# === Contract verification (S-4) ===
# Vercel Sandbox token for the isolated solc compiler farm (set when S-4 lands):
VERCEL_SANDBOX_TOKEN=
